{
  "schema_version": 1,
  "extensions": [
    {
      "id": "btrace-utils",
      "name": "BTrace Utilities",
      "description": "Utility services for BTrace scripts, including printer helpers.",
      "owner": "btraceio",
      "source_repo": "https://github.com/btraceio/btrace",
      "maven": {
        "groupId": "io.btrace",
        "artifactId": "btrace-utils",
        "version": "3.0.0-RC1"
      },
      "compatibility": {
        "min_btrace_version": "3.0.0-RC1"
      },
      "tags": ["utility", "core"]
    },
    {
      "id": "btrace-metrics",
      "name": "BTrace HDR Histogram",
      "description": "High-performance metrics using HdrHistogram for accurate percentile tracking.",
      "owner": "btraceio",
      "source_repo": "https://github.com/btraceio/btrace",
      "maven": {
        "groupId": "io.btrace",
        "artifactId": "btrace-metrics",
        "version": "3.0.0-RC1"
      },
      "compatibility": {
        "min_btrace_version": "3.0.0-RC1"
      },
      "tags": ["metrics", "latency", "histogram"]
    },
    {
      "id": "btrace-statsd",
      "name": "BTrace StatsD",
      "description": "StatsD metrics client for BTrace.",
      "owner": "btraceio",
      "source_repo": "https://github.com/btraceio/btrace",
      "maven": {
        "groupId": "io.btrace",
        "artifactId": "btrace-statsd",
        "version": "3.0.0-RC1"
      },
      "compatibility": {
        "min_btrace_version": "3.0.0-RC1"
      },
      "tags": ["metrics", "statsd", "export"]
    },
    {
      "id": "btrace-otel",
      "name": "BTrace OpenTelemetry",
      "description": "Exports completed spans, DELTA counters and gauges from BTrace scripts to an OpenTelemetry collector over OTLP/HTTP JSON.",
      "owner": "btraceio",
      "source_repo": "https://github.com/btraceio/btrace",
      "maven": {
        "groupId": "io.btrace",
        "artifactId": "btrace-otel",
        "version": "3.0.0-RC1"
      },
      "compatibility": {
        "min_btrace_version": "3.0.0-RC1"
      },
      "tags": ["tracing", "metrics", "opentelemetry", "otlp", "export"]
    }
  ]
}
